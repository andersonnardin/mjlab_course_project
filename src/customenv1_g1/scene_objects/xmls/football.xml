<mujoco model="football">
  <asset>
    <mesh
      name="football_visual_mesh"
      file="assets/football/football.obj"
      scale="0.25 0.25 0.25"/>

    <texture
      name="football_tex"
      type="2d"
      file="assets/football/Image_0.png"/>

    <material
      name="football_mat"
      texture="football_tex"
      texuniform="false"
      reflectance="0.0"
      shininess="0.1"
      specular="0.1"/>
  </asset>

  <worldbody>
    <body name="football_body" pos="0 0 0">
      <freejoint/>

      <!-- Collision sphere (scaled) -->
      <geom
        name="football_collision_geom"
        type="sphere"
        size="0.15"
        density="300"
        contype="1"
        conaffinity="1"
        group="0"
        rgba="1 0 0 0.2"/>

      <!-- Visual mesh -->
      <geom
        name="football_visual_geom"
        type="mesh"
        mesh="football_visual_mesh"
        material="football_mat"
        contype="0"
        conaffinity="0"
        group="1"/>
    </body>
  </worldbody>
</mujoco>